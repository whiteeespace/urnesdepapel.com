# Postgres connection string (local Postgres.app, or Neon on Vercel)
DATABASE_URL=postgres://localhost:5432/urnesdepapel
# Long random string; generate with `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public site origin, used for canonical URLs and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Vercel Blob token for media uploads in production (local uploads go to /media otherwise)
BLOB_READ_WRITE_TOKEN=
# Optional: Resend API key to email new requests (emails are logged to the console otherwise)
RESEND_API_KEY=
# Sender address for request notifications, on a domain verified in Resend
EMAIL_FROM=Urnes de Papel <demandes@urnesdepapel.com>
